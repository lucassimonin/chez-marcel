<section {% if data.anchor|default('') %}id="{{ data.anchor }}"{% endif %} class="scroll-mt-24 bg-paper py-20 sm:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="reveal grid gap-px overflow-hidden rounded-journal bg-line/70 sm:grid-cols-2 lg:grid-cols-4">
            {% for row in data.items|default('')|split_pairs %}
                {% set rest = row.right|split('|') %}
                <div class="bg-paper p-9">
                    <i data-lucide="{{ row.left|trim }}" class="h-8 w-8 text-argile" stroke-width="1.5"></i>
                    <h3 class="mt-5 font-display text-lg font-medium text-forest">{{ rest[0]|default('')|trim }}</h3>
                    <p class="mt-2 text-sm leading-relaxed text-ink/60">{{ rest[1]|default('')|trim }}</p>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
