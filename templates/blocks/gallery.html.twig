<section {% if data.anchor|default('') %}id="{{ data.anchor }}"{% endif %} class="scroll-mt-24 py-20 sm:py-28">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="reveal mb-12 max-w-xl">
            {% if data.kicker %}
                <p class="font-label text-xs uppercase tracking-[0.28em] text-sage">{{ data.kicker }}</p>
            {% endif %}
            {% if data.title %}
                <h2 class="mt-3 font-display text-3xl font-medium italic text-forest sm:text-4xl">{{ data.title }}</h2>
            {% endif %}
        </div>

        {% set placeholders = ['ph-warm', 'ph-salle', 'ph-plat', 'ph-mer', 'ph-glace'] %}
        {% set photos = data.images|default('')|split_pairs %}
        {# La mosaïque compte 5 tuiles (1 grande + 4). Au-delà, les photos
           supplémentaires sont réparties entre les tuiles et défilent. #}
        {% set slots = photos|length > 5 ? 5 : photos|length %}

        <div class="reveal grid auto-rows-[150px] grid-cols-2 gap-3 sm:auto-rows-[170px] sm:grid-cols-4">
            {% for slot in 0..(slots - 1) %}
                {% if slots > 0 %}
                    {# Photos de cette tuile : une sur `slots`, pour répartir les doublons. #}
                    {% set groupe = [] %}
                    {% for index, photo in photos %}
                        {% if index % slots == slot %}
                            {% set groupe = groupe|merge([photo]) %}
                        {% endif %}
                    {% endfor %}

                    <figure class="group relative overflow-hidden rounded-journal {{ slot == 0 ? 'col-span-2 row-span-2' }}"
                            {% if groupe|length > 1 %}data-photo-rotate{% endif %}>
                        {% for photo in groupe %}
                            {% if photo.left %}
                                <img src="{{ photo.left }}" alt="{{ photo.right }}"
                                     data-caption="{{ photo.right }}"
                                     class="absolute inset-0 h-full w-full object-cover transition-opacity duration-700 group-hover:scale-105 {{ loop.first ? 'opacity-100' : 'opacity-0' }}"
                                     loading="lazy">
                            {% else %}
                                <div class="{{ placeholders[slot % placeholders|length] }} absolute inset-0 h-full w-full"></div>
                            {% endif %}
                        {% endfor %}

                        {% if groupe[0].right|default('') %}
                            <figcaption data-gallery-caption
                                        class="absolute bottom-3 left-3 font-label text-[10px] uppercase tracking-[0.08em] text-white drop-shadow transition-opacity duration-700">{{ groupe[0].right }}</figcaption>
                        {% endif %}
                    </figure>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</section>
